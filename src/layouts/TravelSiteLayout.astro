// ============================================================================
// UTILITY PATTERN SEO (noindex rules for dynamic/utility routes)
// ============================================================================

type UtilityPatternSeo = {
  title: string;
  description: string;
  noIndex: true;
};

const UTILITY_PATTERNS: Record<string, UtilityPatternSeo> = {
  '/booking-calendar': {
    title: 'Select a Booking Date | Top Euro Travel',
    description: 'Choose an available date for your Top Euro Travel experience.',
    noIndex: true,
  },
  '/booking-form': {
    title: 'Complete Your Booking | Top Euro Travel',
    description: 'Complete your Top Euro Travel experience booking.',
    noIndex: true,
  },
  '/excursion-preview': {
    title: 'Excursion Preview | Top Euro Travel',
    description: 'Preview a Top Euro Travel excursion.',
    noIndex: true,
  },
};

// ============================================================================
// STRUCTURED DATA BUILDER (mirrored from PageSeo)
// ============================================================================

function buildStructuredData({
  canonicalUrl,
  title,
  description,
  image,
  keywords,
  pageLabel,
  normalizedPath,
}: {
  canonicalUrl: string;
  title: string;
  description: string;
  image: string;
  keywords: string[];
  pageLabel: string;
  normalizedPath: string;
}): Record<string, unknown> {
  const origin = new URL(canonicalUrl).origin;
  const organizationId = origin + '/#organization';
  const websiteId = origin + '/#website';
  const webpageId = canonicalUrl + '#webpage';
  const breadcrumbId = canonicalUrl + '#breadcrumb';

  const graph: Array<Record<string, unknown>> = [
    {
      '@type': 'TravelAgency',
      '@id': organizationId,
      name: 'Top Euro Travel',
      url: origin + '/',
      image,
      foundingDate: '1989',
      telephone: '+302241045506',
      email: 'info@topeurotravel.gr',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '5th Km Rhodes-Lindos Avenue',
        addressLocality: 'Rhodes',
        postalCode: '851 00',
        addressCountry: 'GR',
      },
      areaServed: [
        { '@type': 'Continent', name: 'Europe' },
        { '@type': 'Country', name: 'Greece' },
      ],
      availableLanguage: {
        '@type': 'Language',
        name: 'English',
        alternateName: 'en',
      },
      sameAs: [
        'https://www.linkedin.com/company/topeurotravel',
        'https://www.facebook.com/TopEuroTravel',
        'https://www.instagram.com/topeurotravel_/',
      ],
    },
  ];

  if (normalizedPath === '/') {
    graph.push({
      '@type': 'WebSite',
      '@id': websiteId,
      url: origin + '/',
      name: 'Top Euro Travel',
      inLanguage: 'en',
      publisher: { '@id': organizationId },
    });
  }

  const webPage: Record<string, unknown> = {
    '@type': 'WebPage',
    '@id': webpageId,
    url: canonicalUrl,
    name: title,
    description,
    inLanguage: 'en',
    isPartOf: { '@id': websiteId },
    about: { '@id': organizationId },
    primaryImageOfPage: {
      '@type': 'ImageObject',
      url: image,
    },
    keywords: keywords.join(', '),
  };

  if (normalizedPath !== '/') {
    webPage.breadcrumb = { '@id': breadcrumbId };
  }
  graph.push(webPage);

  if (normalizedPath !== '/') {
    graph.push({
      '@type': 'BreadcrumbList',
      '@id': breadcrumbId,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: origin + '/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: pageLabel,
          item: canonicalUrl,
        },
      ],
    });
  }

  return {
    '@context': 'https://schema.org',
    '@graph': graph,
  };
}

// ============================================================================
// RESOLVE REQUEST URL (normalize trailing slashes)
// ============================================================================

function getRequestPath(): string {
  // Try to get the forwarded URL from x-wix-forwarded-url header
  const forwardedUrl = Astro.request.headers.get('x-wix-forwarded-url');

  if (forwardedUrl) {
    try {
      const url = new URL(forwardedUrl);
      if (url.protocol === 'http:' || url.protocol === 'https:') {
        let pathname = url.pathname;
        // Normalize trailing slashes: remove trailing slash unless it's root
        if (pathname !== '/' && pathname.endsWith('/')) {
          pathname = pathname.slice(0, -1);
        }
        return pathname;
      }
    } catch {
      // Invalid URL, fall through to Astro.url
    }
  }

  // Fallback to Astro.url
  let pathname = Astro.url.pathname;
  if (pathname !== '/' && pathname.endsWith('/')) {
    pathname = pathname.slice(0, -1);
  }
  return pathname;
}

const requestPath = getRequestPath();

// ============================================================================
// DETERMINE SEO FOR CURRENT REQUEST
// ============================================================================

type SeoContext = {
  title: string;
  description: string;
  image: string;
  robots: string;
  canonicalUrl: string;
  noIndex: boolean;
  keywords: string[];
  pageLabel: string;
  structuredData?: Record<string, unknown>;
};

function getSeoForPath(pathname: string, origin: string): SeoContext | null {
  // Check exact-path routes
  const exactSeo = ROUTE_SEO[pathname];
  if (exactSeo) {
    const canonicalUrl = origin + (pathname === '/' ? '/' : pathname);
    const robots = exactSeo.noIndex
      ? 'noindex, follow'
      : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

    const structuredData = !exactSeo.noIndex
      ? buildStructuredData({
          canonicalUrl,
          title: exactSeo.title,
          description: exactSeo.description,
          image: DEFAULT_SEO_IMAGE,
          keywords: exactSeo.keywords,
          pageLabel: exactSeo.label,
          normalizedPath: pathname,
        })
      : undefined;

    return {
      title: exactSeo.title,
      description: exactSeo.description,
      image: DEFAULT_SEO_IMAGE,
      robots,
      canonicalUrl,
      noIndex: exactSeo.noIndex ?? false,
      keywords: exactSeo.keywords,
      pageLabel: exactSeo.label,
      structuredData,
    };
  }

  // Check utility patterns
  if (/^\/booking-calendar\//.test(pathname)) {
    const canonicalUrl = origin + pathname;
    return {
      title: UTILITY_PATTERNS['/booking-calendar'].title,
      description: UTILITY_PATTERNS['/booking-calendar'].description,
      image: DEFAULT_SEO_IMAGE,
      robots: 'noindex, follow',
      canonicalUrl,
      noIndex: true,
      keywords: ['Top Euro Travel booking calendar'],
      pageLabel: 'Booking Calendar',
    };
  }

  if (/^\/booking-form\//.test(pathname)) {
    const canonicalUrl = origin + pathname;
    return {
      title: UTILITY_PATTERNS['/booking-form'].title,
      description: UTILITY_PATTERNS['/booking-form'].description,
      image: DEFAULT_SEO_IMAGE,
      robots: 'noindex, follow',
      canonicalUrl,
      noIndex: true,
      keywords: ['Top Euro Travel booking form'],
      pageLabel: 'Booking Form',
    };
  }

  if (/^\/excursion-preview\//.test(pathname)) {
    const canonicalUrl = origin + pathname;
    return {
      title: UTILITY_PATTERNS['/excursion-preview'].title,
      description: UTILITY_PATTERNS['/excursion-preview'].description,
      image: DEFAULT_SEO_IMAGE,
      robots: 'noindex, nofollow',
      canonicalUrl,
      noIndex: true,
      keywords: ['Top Euro Travel excursion preview'],
      pageLabel: 'Excursion Preview',
    };
  }

  // Dynamic item pages (/blog/[slug], /excursions/[slug]) are NOT handled here
  // They use their own <SEO.Tags slot="seo-tags"> in React components
  return null;
}

const origin = Astro.url.origin.replace(/^http:/, 'https:');
const seoContext = getSeoForPath(requestPath, origin);
---

<html lang="en" class="w-full h-full">
  <head>
    <Head />

    {/* ========================================================================
        SERVER-RENDERED SEO TAGS FOR EXACT-PATH ROUTES
        ======================================================================== */}
    {seoContext && (
      <>
        <title>{seoContext.title}</title>
        <meta name="description" content={seoContext.description} />
        <meta name="robots" content={seoContext.robots} />
        <meta name="googlebot" content={seoContext.robots} />

        <link rel="canonical" href={seoContext.canonicalUrl} />
        <link rel="alternate" href={seoContext.canonicalUrl} hreflang="en" />
        <link rel="alternate" href={seoContext.canonicalUrl} hreflang="x-default" />

        <meta property="og:title" content={seoContext.title} />
        <meta property="og:description" content={seoContext.description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={seoContext.canonicalUrl} />
        <meta property="og:site_name" content="Top Euro Travel" />
        <meta property="og:locale" content="en_GB" />
        <meta property="og:image" content={seoContext.image} />
        <meta property="og:image:alt" content={DEFAULT_SEO_IMAGE_ALT} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={seoContext.title} />
        <meta name="twitter:description" content={seoContext.description} />
        <meta name="twitter:image" content={seoContext.image} />

        {seoContext.structuredData && (
          <script id="top-euro-travel-structured-data" type="application/ld+json" set:html={JSON.stringify(seoContext.structuredData)} />
        )}
      </>
    )}

    {/* ========================================================================
        DYNAMIC ITEM PAGE SEO (from React components)
        ======================================================================== */}
    <slot name="seo-tags" />
  </head>
  <body class="w-full h-full">
    <div id="root" class="w-full h-full">
      <AppRouter client:only="react" />
    </div>
  </body>
</html>
