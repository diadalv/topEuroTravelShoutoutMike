---
import TravelSiteLayout from "@/layouts/TravelSiteLayout.astro";
import { seoTags } from "@wix/seo";
import { SEO } from "@wix/seo/components";
import { loadSEOTagsServiceConfig } from "@wix/seo/services";

// Wix application and item-page constants from @wix/essentials 1.0.10.
export const wixMetadata = {
  appDefId: "13d21c63-b5ec-5912-8397-c3a5ddb27a97",
  pageIdentifier: "wix.bookings.sub_pages.service_page",
  identifiers: {
    slug: "BOOKINGS.SERVICE.SLUG",
  },
};

const slug = Astro.params.slug!;
const forwardedUrl = Astro.request.headers.get("x-wix-forwarded-url");
const pageUrl =
  forwardedUrl &&
  URL.canParse(forwardedUrl) &&
  /^https?:$/.test(new URL(forwardedUrl).protocol)
    ? forwardedUrl
    : Astro.url.href;

const seoTagsServiceConfig = await loadSEOTagsServiceConfig({
  pageUrl,
  itemType: seoTags.ItemType.BOOKINGS_SERVICE,
  itemData: { slug },
});

seoTagsServiceConfig.tags = seoTagsServiceConfig.tags.map((tag) => {
  const children =
    typeof tag.children === "string"
      ? tag.children.replaceAll("New TopEuroTravel", "Top Euro Travel")
      : tag.children;
  const props =
    tag.props && typeof tag.props.content === "string"
      ? {
          ...tag.props,
          content: tag.props.content.replaceAll(
            "New TopEuroTravel",
            "Top Euro Travel",
          ),
        }
      : tag.props;

  return { ...tag, children, props };
});
---

<TravelSiteLayout>
  <SEO.Tags seoTagsServiceConfig={seoTagsServiceConfig} slot="seo-tags" />
</TravelSiteLayout>
